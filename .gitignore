node_modules
lib

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.node

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Wycheproof vectors are downloaded by scripts/fetch-wycheproof.mjs
/tests/data/wycheproof/*.json
/tests/data/wycheproof/.wycheproof-ref

# NIST CAVP vectors are downloaded by scripts/fetch-nist.mjs
/tests/data/nist/**
!/tests/data/nist/README.md
